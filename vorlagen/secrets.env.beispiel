# Zugangsdaten fuer die Uebertragungen.
#
# Ablage: ~/.config/tontechnik/secrets.env (legt ./installiere.sh an),
# Rechte 600. Werte mit Sonderzeichen immer in einfache Anfuehrungszeichen,
# sonst zerlegt die Shell sie: SIP_PASS='ab$cd'

# Telefon: eigenes IP-Telefon in der Fritz!Box, ruft die Moderator-Rufnummer
# der Konferenz an. SIP_USER ist der Anmeldename, nicht der Geraetename.
SIP_HOST='fritz.box'
SIP_USER=''
SIP_PASS=''
MODERATOR_RUFNUMMER=''

# Mithoeren: zweites IP-Telefon in der Fritz!Box, waehlt sich wie ein Zuhoerer
# ueber die Teilnehmer-Rufnummer ein. Dient nur der Pegelkontrolle.
SIP_MITHOEREN_USER=''
SIP_MITHOEREN_PASS=''
TEILNEHMER_RUFNUMMER=''

# Radio: Icecast-Server
ICECAST_HOST=''
ICECAST_PORT='8000'
ICECAST_MOUNT='/stream'
ICECAST_USER='source'
ICECAST_PASS=''
ICECAST_BITRATE='128k'
ICECAST_NAME='Uebertragung'
